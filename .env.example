# Identity (NIP-11)
# RELAY_NAME=relayxyz
# RELAY_DESCRIPTION=A private Nostr relay
# RELAY_PUBKEY=<64-char hex pubkey>
# RELAY_CONTACT=operator@example.com
# RELAY_ICON_URL=http://localhost:7777/public/logo

# Network
# RELAY_BIND=0.0.0.0:7777

# Storage
# RELAY_DB_PATH=relay.redb

# Authentication (NIP-42)
# RELAY_REQUIRE_AUTH=false
# RELAY_URL=wss://relay.example.com
# RELAY_ADMIN_KEY=changeme
# RELAY_ALLOWED_KINDS=0,1,2,3,4,5,6,7,16,1111,9735,10000,10001,10002
# RELAY_MAX_CONTENT_GRAPHEMES=180

# Operational limits
# RELAY_MIN_EVENT_INTERVAL_MS=1000
# RELAY_MAX_SUBSCRIPTIONS=20
# RELAY_MAX_MESSAGE_LENGTH=65536
# RELAY_DEFAULT_QUERY_LIMIT=500

# Abuse detection
# RELAY_ABUSE_STRIKE_LIMIT=10
# RELAY_ABUSE_STRIKE_WINDOW_SECS=60
# RELAY_ABUSE_SUSPEND_SECS=300
